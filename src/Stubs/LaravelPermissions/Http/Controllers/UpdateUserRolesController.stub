<?php

declare(strict_types=1);

namespace Lightit\Shared\Permissions\App\Controllers;

use Illuminate\Http\JsonResponse;
use Lightit\Shared\Permissions\App\Requests\UpdateUserRolesRequest;
use Lightit\Shared\Permissions\App\Resources\RoleResource;
use Lightit\Shared\Permissions\Domain\Actions\SyncUserRolesAction;
use Lightit\Users\Domain\Models\User;

class UpdateUserRolesController
{
    public function __construct(
        private readonly SyncUserRolesAction $syncUserRolesAction,
    ) {
    }

    public function __invoke(UpdateUserRolesRequest $request, User $user): JsonResponse
    {
        $updatedUser = $this->syncUserRolesAction->execute($user, $request->getRoleNames());

        return RoleResource::collection($updatedUser->roles)->response();
    }
}
