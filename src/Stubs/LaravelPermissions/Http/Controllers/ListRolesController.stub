<?php

declare(strict_types=1);

namespace Lightit\Shared\Permissions\App\Controllers;

use Illuminate\Http\JsonResponse;
use Lightit\Shared\Permissions\App\Resources\RoleResource;
use Lightit\Shared\Permissions\Domain\Actions\ListRolesAction;

class ListRolesController
{
    public function __invoke(ListRolesAction $listRolesAction): JsonResponse
    {
        return RoleResource::collection($listRolesAction->execute())->response();
    }
}
