<?php

declare(strict_types=1);

namespace Lightit\Roles\Domain\Exceptions;

use Lightit\Shared\App\Exceptions\Http\HttpException;

final class LastSuperAdminException extends HttpException
{
    public function __construct()
    {
        $this->status = 409;
        $this->errorCode = 'last_super_admin';

        parent::__construct('The last super admin cannot lose that role.');
    }
}
