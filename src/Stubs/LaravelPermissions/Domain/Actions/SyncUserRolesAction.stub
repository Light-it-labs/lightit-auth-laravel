<?php

declare(strict_types=1);

namespace Lightit\Roles\Domain\Actions;

use Illuminate\Database\Eloquent\Collection;
use Illuminate\Support\Facades\DB;
use Lightit\Roles\Domain\Exceptions\LastSuperAdminException;
use Lightit\Shared\Roles\RoleManagement;
use Lightit\Users\Domain\Models\User;
use Spatie\Permission\Guard;
use Spatie\Permission\Models\Role;

final readonly class SyncUserRolesAction
{
    /**
     * @param Collection<int, Role> $roles
     *
     * @throws LastSuperAdminException
     */
    public function execute(User $user, Collection $roles): User
    {
        return DB::transaction(function () use ($user, $roles): User {
            if ($this->removesSuperAdmin($user, $roles) && $this->superAdminCountUnderLock() <= 1) {
                throw new LastSuperAdminException;
            }

            $user->syncRoles($roles);

            return $user->load('roles');
        });
    }

    /**
     * @param Collection<int, Role> $roles
     */
    private function removesSuperAdmin(User $user, Collection $roles): bool
    {
        return $user->hasRole(RoleManagement::ROLE_SUPER_ADMIN)
            && $roles->doesntContain(static fn (Role $role): bool => $role->name === RoleManagement::ROLE_SUPER_ADMIN);
    }

    /**
     * Every demotion locks the super admin role row first, so they queue on one row: locking
     * `users` rows alone doesn't, because membership lives in `model_has_roles`. The count is a
     * locking read too, so MySQL reads the latest commit instead of the transaction's snapshot;
     * it counts plucked ids because PostgreSQL rejects `FOR UPDATE` on an aggregate.
     */
    private function superAdminCountUnderLock(): int
    {
        Role::query()
            ->where('name', RoleManagement::ROLE_SUPER_ADMIN)
            ->where('guard_name', Guard::getDefaultName(User::class))
            ->lockForUpdate()
            ->firstOrFail();

        return count(
            User::query()
                ->role(RoleManagement::ROLE_SUPER_ADMIN)
                ->lockForUpdate()
                ->pluck('id')
                ->all(),
        );
    }
}
