<?php

declare(strict_types=1);

namespace Lightit\Roles\App\Controllers;

use Illuminate\Container\Attributes\CurrentUser;
use Illuminate\Http\JsonResponse;
use Lightit\Roles\App\Resources\CurrentUserPermissionsResource;
use Lightit\Users\Domain\Models\User;

final readonly class ShowCurrentUserPermissionsController
{
    public function __invoke(
        #[CurrentUser]
        User $user,
    ): JsonResponse {
        return CurrentUserPermissionsResource::make($user)->response();
    }
}
