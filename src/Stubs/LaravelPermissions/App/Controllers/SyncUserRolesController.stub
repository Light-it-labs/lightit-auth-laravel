<?php

declare(strict_types=1);

namespace Lightit\Roles\App\Controllers;

use Illuminate\Container\Attributes\CurrentUser;
use Illuminate\Http\JsonResponse;
use Lightit\Roles\App\Requests\SyncUserRolesRequest;
use Lightit\Roles\App\Resources\UserWithRolesResource;
use Lightit\Roles\Domain\Actions\SyncUserRolesAction;
use Lightit\Users\Domain\Models\User;

final readonly class SyncUserRolesController
{
    public function __invoke(
        SyncUserRolesRequest $request,
        #[CurrentUser]
        User $actor,
        User $user,
        SyncUserRolesAction $action,
    ): JsonResponse {
        return UserWithRolesResource::make($action->execute($actor, $user, $request->roles()))->response();
    }
}
