<?php

declare(strict_types=1);

namespace Lightit\Roles\App\Resources;

use Illuminate\Http\Request;
use Illuminate\Http\Resources\Json\JsonResource;
use Lightit\Users\Domain\Models\User;

/**
 * @mixin User
 */
final class CurrentUserPermissionsResource extends JsonResource
{
    /**
     * @return array{roles: list<string>, permissions: list<string>}
     */
    public function toArray(Request $request): array
    {
        return [
            'roles' => $this->getRoleNames()->sort()->values()->all(),
            'permissions' => $this->getAllPermissions()->pluck('name')->sort()->values()->all(),
        ];
    }
}
