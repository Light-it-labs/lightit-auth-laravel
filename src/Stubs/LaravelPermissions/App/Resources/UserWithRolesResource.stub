<?php

declare(strict_types=1);

namespace Lightit\Roles\App\Resources;

use Illuminate\Http\Request;
use Illuminate\Http\Resources\Json\JsonResource;
use Lightit\Users\Domain\Models\User;

/**
 * @mixin User
 */
final class UserWithRolesResource extends JsonResource
{
    public function toArray(Request $request): array
    {
        return [
            'id' => $this->id,
            'name' => $this->name,
            'email_address' => $this->email,
            'roles' => $this->whenLoaded('roles', fn (): array => $this->roles->pluck('name')->sort()->values()->all()),
        ];
    }
}
