<?php

declare(strict_types=1);

namespace Lightit\Roles\App\Requests;

use Illuminate\Container\Attributes\CurrentUser;
use Illuminate\Container\Attributes\RouteParameter;
use Illuminate\Foundation\Http\FormRequest;
use Illuminate\Support\Facades\Config;
use Illuminate\Validation\Rule;
use Lightit\Roles\Domain\Exceptions\SuperAdminRoleChangeForbiddenException;
use Lightit\Shared\Roles\RoleManagement;
use Lightit\Users\Domain\Models\User;
use Spatie\Permission\Guard;

final class SyncUserRolesRequest extends FormRequest
{
    public const string ROLES = 'roles';

    /**
     * @throws SuperAdminRoleChangeForbiddenException
     */
    public function authorize(
        #[CurrentUser]
        User $actor,
        #[RouteParameter('user')]
        User $user,
    ): bool {
        $changesSuperAdmin = $user->hasRole(RoleManagement::ROLE_SUPER_ADMIN)
            !== in_array(RoleManagement::ROLE_SUPER_ADMIN, $this->roleNames(), true);

        if ($changesSuperAdmin && ! $actor->hasRole(RoleManagement::ROLE_SUPER_ADMIN)) {
            throw new SuperAdminRoleChangeForbiddenException;
        }

        return true;
    }

    public function rules(): array
    {
        return [
            self::ROLES => ['present', 'array'],
            self::ROLES . '.*' => [
                'string',
                'distinct',
                Rule::exists(Config::string('permission.table_names.roles'), 'name')
                    ->where('guard_name', Guard::getDefaultName(User::class)),
            ],
        ];
    }

    /**
     * @return list<string>
     */
    public function roleNames(): array
    {
        return array_values(array_filter($this->collect(self::ROLES)->all(), is_string(...)));
    }
}
