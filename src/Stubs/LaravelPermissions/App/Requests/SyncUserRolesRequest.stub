<?php

declare(strict_types=1);

namespace Lightit\Roles\App\Requests;

use Illuminate\Container\Attributes\CurrentUser;
use Illuminate\Container\Attributes\RouteParameter;
use Illuminate\Foundation\Http\FormRequest;
use Illuminate\Support\Facades\Config;
use Illuminate\Validation\Rule;
use Lightit\Roles\Domain\Exceptions\RoleAssignmentForbiddenException;
use Lightit\Roles\Domain\Exceptions\SuperAdminRoleChangeForbiddenException;
use Lightit\Shared\Roles\RoleManagement;
use Lightit\Users\Domain\Models\User;
use Spatie\Permission\Guard;
use Spatie\Permission\Models\Role;

final class SyncUserRolesRequest extends FormRequest
{
    public const string ROLES = 'roles';

    /**
     * Anyone with roles.manage (checked on the route) may change roles, but only a super admin
     * may change super-admin or a role granting a permission they don't hold themselves.
     *
     * @throws SuperAdminRoleChangeForbiddenException
     * @throws RoleAssignmentForbiddenException
     */
    public function authorize(
        #[CurrentUser]
        User $actor,
        #[RouteParameter('user')]
        User $user,
    ): bool {
        if ($actor->hasRole(RoleManagement::ROLE_SUPER_ADMIN)) {
            return true;
        }

        $currentRoles = array_values(array_filter($user->getRoleNames()->all(), is_string(...)));
        $requestedRoles = $this->roleNames();
        $changedRoles = [
            ...array_diff($currentRoles, $requestedRoles),
            ...array_diff($requestedRoles, $currentRoles),
        ];

        if (in_array(RoleManagement::ROLE_SUPER_ADMIN, $changedRoles, true)) {
            throw new SuperAdminRoleChangeForbiddenException;
        }

        if (! $this->holdsEveryPermissionOf($actor, $changedRoles)) {
            throw new RoleAssignmentForbiddenException;
        }

        return true;
    }

    public function rules(): array
    {
        return [
            self::ROLES => ['present', 'array'],
            self::ROLES . '.*' => [
                'string',
                'distinct',
                Rule::exists(Config::string('permission.table_names.roles'), 'name')
                    ->where('guard_name', Guard::getDefaultName(User::class)),
            ],
        ];
    }

    /**
     * @param list<string> $roleNames
     */
    private function holdsEveryPermissionOf(User $actor, array $roleNames): bool
    {
        $actorPermissions = $actor->getAllPermissions()->pluck('name');

        return Role::query()
            ->whereIn('name', $roleNames)
            ->where('guard_name', Guard::getDefaultName(User::class))
            ->with('permissions')
            ->get()
            ->every(static fn (Role $role): bool => $role->permissions->pluck('name')->diff($actorPermissions)->isEmpty());
    }

    /**
     * @return list<string>
     */
    public function roleNames(): array
    {
        return array_values(array_filter($this->collect(self::ROLES)->all(), is_string(...)));
    }
}
