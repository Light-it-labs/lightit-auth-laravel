<?php

declare(strict_types=1);

namespace Lightit\Authentication\Domain\Exceptions;

use Lightit\Shared\App\Exceptions\Http\HttpException;

final class PasskeyLoginFailedException extends HttpException
{
    #[\Override]
    protected int $status = 422;

    #[\Override]
    protected string $errorCode = 'passkey_login_failed';

    /**
     * @var string
     */
    #[\Override]
    protected $message = 'The passkey could not be verified.';
}
