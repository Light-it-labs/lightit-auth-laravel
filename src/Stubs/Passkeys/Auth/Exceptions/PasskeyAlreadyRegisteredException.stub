<?php

declare(strict_types=1);

namespace Lightit\Authentication\Domain\Exceptions;

use Lightit\Shared\App\Exceptions\Http\HttpException;

final class PasskeyAlreadyRegisteredException extends HttpException
{
    #[\Override]
    protected int $status = 409;

    #[\Override]
    protected string $errorCode = 'passkey_already_registered';

    /**
     * @var string
     */
    #[\Override]
    protected $message = 'This passkey is already registered.';
}
