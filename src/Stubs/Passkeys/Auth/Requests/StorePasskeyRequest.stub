<?php

declare(strict_types=1);

namespace Lightit\Authentication\App\Requests;

use Illuminate\Foundation\Http\FormRequest;
use Lightit\Authentication\Domain\DataTransferObjects\StorePasskeyDto;

final class StorePasskeyRequest extends FormRequest
{
    public const string NAME = 'name';

    public const string CREDENTIAL = 'credential';

    /**
     * @return array<string, array<int, string>>
     */
    public function rules(): array
    {
        return [
            self::NAME => ['required', 'string', 'max:100'],
            self::CREDENTIAL => ['required', 'array'],
        ];
    }

    public function toDto(): StorePasskeyDto
    {
        return new StorePasskeyDto(
            name: $this->string(self::NAME)->toString(),
            credential: json_encode($this->array(self::CREDENTIAL), JSON_THROW_ON_ERROR),
        );
    }
}
