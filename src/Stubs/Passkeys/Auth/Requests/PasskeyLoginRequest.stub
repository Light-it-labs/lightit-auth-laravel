<?php

declare(strict_types=1);

namespace Lightit\Authentication\App\Requests;

use Illuminate\Foundation\Http\FormRequest;
use Lightit\Authentication\Domain\DataTransferObjects\PasskeyLoginDto;

final class PasskeyLoginRequest extends FormRequest
{
    public const string CEREMONY_ID = 'ceremony_id';

    public const string CREDENTIAL = 'credential';

    public function rules(): array
    {
        return [
            self::CEREMONY_ID => ['required', 'string'],
            self::CREDENTIAL => ['required', 'array'],
        ];
    }

    public function toDto(): PasskeyLoginDto
    {
        return new PasskeyLoginDto(
            ceremonyId: $this->string(self::CEREMONY_ID)->toString(),
            credential: (array) $this->input(self::CREDENTIAL),
        );
    }
}
