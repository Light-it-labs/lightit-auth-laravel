<?php

declare(strict_types=1);

namespace Lightit\Authentication\App\Resources;

use Dedoc\Scramble\Attributes\SchemaName;
use Illuminate\Http\Request;
use Illuminate\Http\Resources\Json\JsonResource;

/**
 * @property string $resource
 */
#[SchemaName('PasskeyRegistrationOptions')]
final class PasskeyRegistrationOptionsResource extends JsonResource
{
    /**
     * @return array<string, mixed>
     */
    public function toArray(Request $request): array
    {
        /** @var array<string, mixed> $options */
        $options = json_decode($this->resource, true, flags: JSON_THROW_ON_ERROR);

        return $options;
    }
}
