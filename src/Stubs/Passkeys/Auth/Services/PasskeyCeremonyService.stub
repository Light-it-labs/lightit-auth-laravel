<?php

declare(strict_types=1);

namespace Lightit\Authentication\Domain\Services;

use Cose\Algorithms;
use Illuminate\Contracts\Debug\ExceptionHandler;
use Illuminate\Support\Facades\Config;
use Illuminate\Support\Facades\Log;
use InvalidArgumentException;
use Lightit\Authentication\Domain\DataTransferObjects\VerifiedPasskeyAssertionDto;
use Lightit\Authentication\Domain\DataTransferObjects\VerifiedPasskeyDto;
use Lightit\Authentication\Domain\Exceptions\PasskeyLoginFailedException;
use Lightit\Authentication\Domain\Exceptions\PasskeyNotRecognisedException;
use Lightit\Authentication\Domain\Exceptions\PasskeyRegistrationFailedException;
use Lightit\Authentication\Domain\Models\Passkey;
use Lightit\Users\Domain\Models\User;
use ParagonIE\ConstantTime\Base64UrlSafe;
use RangeException;
use RuntimeException;
use Symfony\Component\Serializer\Exception\ExceptionInterface as SerializerException;
use Symfony\Component\Serializer\Normalizer\AbstractObjectNormalizer;
use Symfony\Component\Serializer\SerializerInterface;
use Symfony\Component\Uid\Uuid;
use Throwable;
use TypeError;
use ValueError;
use Webauthn\AttestationStatement\AttestationStatementSupportManager;
use Webauthn\AttestationStatement\NoneAttestationStatementSupport;
use Webauthn\AuthenticatorAssertionResponse;
use Webauthn\AuthenticatorAssertionResponseValidator;
use Webauthn\AuthenticatorAttestationResponse;
use Webauthn\AuthenticatorAttestationResponseValidator;
use Webauthn\AuthenticatorSelectionCriteria;
use Webauthn\CeremonyStep\CeremonyStepManagerFactory;
use Webauthn\CredentialRecord;
use Webauthn\Denormalizer\WebauthnSerializerFactory;
use Webauthn\Exception\WebauthnException;
use Webauthn\PublicKeyCredential;
use Webauthn\PublicKeyCredentialCreationOptions;
use Webauthn\PublicKeyCredentialDescriptor;
use Webauthn\PublicKeyCredentialParameters;
use Webauthn\PublicKeyCredentialRequestOptions;
use Webauthn\PublicKeyCredentialRpEntity;
use Webauthn\PublicKeyCredentialUserEntity;
use Webauthn\TrustPath\EmptyTrustPath;

final readonly class PasskeyCeremonyService
{
    private const array ALGORITHMS = [Algorithms::COSE_ALGORITHM_ES256, Algorithms::COSE_ALGORITHM_RS256];

    private SerializerInterface $serializer;

    public function __construct(private ExceptionHandler $exceptionHandler)
    {
        $this->serializer = new WebauthnSerializerFactory(
            new AttestationStatementSupportManager([new NoneAttestationStatementSupport]),
        )->create();
    }

    public function creationOptions(User $user): string
    {
        $options = PublicKeyCredentialCreationOptions::create(
            rp: PublicKeyCredentialRpEntity::create(
                name: Config::string('passkeys.relying_party.name'),
                id: $this->relyingPartyId(),
            ),
            user: PublicKeyCredentialUserEntity::create(
                name: (string) $user->email,
                id: $this->userHandle($user->id),
                displayName: $user->name,
            ),
            challenge: random_bytes(32),
            pubKeyCredParams: array_map(
                PublicKeyCredentialParameters::createPk(...),
                self::ALGORITHMS,
            ),
            authenticatorSelection: AuthenticatorSelectionCriteria::create(
                userVerification: AuthenticatorSelectionCriteria::USER_VERIFICATION_REQUIREMENT_REQUIRED,
                residentKey: AuthenticatorSelectionCriteria::RESIDENT_KEY_REQUIREMENT_REQUIRED,
            ),
            attestation: PublicKeyCredentialCreationOptions::ATTESTATION_CONVEYANCE_PREFERENCE_NONE,
            excludeCredentials: $this->registeredCredentials($user),
            timeout: $this->timeoutMilliseconds(),
        );

        return $this->serializer->serialize($options, 'json', [
            AbstractObjectNormalizer::SKIP_NULL_VALUES => true,
        ]);
    }

    /**
     * On malformed input the library throws TypeError, RangeException, ValueError and
     * serializer exceptions besides its own, so all of them are a rejected ceremony. They
     * are logged as warnings rather than reported, so a wrong RP ID or origin leaves a
     * trace without reporting every user's bad device.
     *
     * @throws PasskeyRegistrationFailedException
     */
    public function verifyRegistration(string $options, string $credential): VerifiedPasskeyDto
    {
        $relyingPartyId = $this->relyingPartyId();
        $ceremonySteps = $this->ceremonySteps()->creationCeremony();

        try {
            $creationOptions = $this->serializer->deserialize(
                $options,
                PublicKeyCredentialCreationOptions::class,
                'json',
            );
            $publicKeyCredential = $this->serializer->deserialize($credential, PublicKeyCredential::class, 'json');

            if (! $publicKeyCredential->response instanceof AuthenticatorAttestationResponse) {
                throw new InvalidArgumentException('The credential is not an attestation response.');
            }

            $record = AuthenticatorAttestationResponseValidator::create($ceremonySteps)
                ->check($publicKeyCredential->response, $creationOptions, $relyingPartyId);
        } catch (WebauthnException|SerializerException|InvalidArgumentException|RangeException|TypeError|ValueError $exception) {
            Log::warning('passkey registration rejected', [
                'reason' => $exception::class,
                'message' => $exception->getMessage(),
            ]);

            throw new PasskeyRegistrationFailedException;
        } catch (Throwable $throwable) {
            $this->exceptionHandler->report($throwable);

            throw new PasskeyRegistrationFailedException;
        }

        return new VerifiedPasskeyDto(
            credentialIdHash: hash('sha256', $record->publicKeyCredentialId),
            credentialId: Base64UrlSafe::encodeUnpadded($record->publicKeyCredentialId),
            publicKey: Base64UrlSafe::encodeUnpadded($record->credentialPublicKey),
            signCount: $record->counter,
            transports: array_values(array_filter($record->transports, is_string(...))),
            aaguid: $record->aaguid->toRfc4122(),
            backupEligible: $record->backupEligible ?? false,
            backupStatus: $record->backupStatus ?? false,
        );
    }

    public function requestOptions(): string
    {
        $options = PublicKeyCredentialRequestOptions::create(
            challenge: random_bytes(32),
            rpId: $this->relyingPartyId(),
            userVerification: PublicKeyCredentialRequestOptions::USER_VERIFICATION_REQUIREMENT_REQUIRED,
            timeout: $this->timeoutMilliseconds(),
        );

        return $this->serializer->serialize($options, 'json', [
            AbstractObjectNormalizer::SKIP_NULL_VALUES => true,
        ]);
    }

    /**
     * @throws PasskeyLoginFailedException
     * @throws PasskeyNotRecognisedException
     */
    public function verifyAssertion(string $options, string $credential): VerifiedPasskeyAssertionDto
    {
        $relyingPartyId = $this->relyingPartyId();
        $ceremonySteps = $this->ceremonySteps()->requestCeremony();

        [$requestOptions, $publicKeyCredential, $response] = $this->guardLogin(
            function () use ($options, $credential): array {
                $requestOptions = $this->serializer->deserialize(
                    $options,
                    PublicKeyCredentialRequestOptions::class,
                    'json',
                );
                $publicKeyCredential = $this->serializer->deserialize(
                    $credential,
                    PublicKeyCredential::class,
                    'json',
                );

                if (! $publicKeyCredential->response instanceof AuthenticatorAssertionResponse) {
                    throw new InvalidArgumentException('The credential is not an assertion response.');
                }

                return [$requestOptions, $publicKeyCredential, $publicKeyCredential->response];
            },
        );

        $passkey = Passkey::query()
            ->where('credential_id_hash', hash('sha256', $publicKeyCredential->rawId))
            ->first() ?? throw new PasskeyNotRecognisedException;

        $ownerHandle = $this->userHandle($passkey->user_id);

        $record = $this->guardLogin(
            static fn (): CredentialRecord => AuthenticatorAssertionResponseValidator::create($ceremonySteps)->check(
                CredentialRecord::create(
                    publicKeyCredentialId: $publicKeyCredential->rawId,
                    type: PublicKeyCredentialDescriptor::CREDENTIAL_TYPE_PUBLIC_KEY,
                    transports: array_values(array_filter($passkey->transports, is_string(...))),
                    attestationType: 'none',
                    trustPath: EmptyTrustPath::create(),
                    aaguid: Uuid::fromString($passkey->aaguid),
                    credentialPublicKey: Base64UrlSafe::decodeNoPadding($passkey->public_key),
                    userHandle: $ownerHandle,
                    counter: $passkey->sign_count,
                    backupEligible: $passkey->backup_eligible,
                    backupStatus: $passkey->backup_status,
                ),
                $response,
                $requestOptions,
                $relyingPartyId,
                null,
            ),
        );

        return new VerifiedPasskeyAssertionDto(
            passkey: $passkey,
            signCount: $record->counter,
            backupEligible: $record->backupEligible ?? $passkey->backup_eligible,
            backupStatus: $record->backupStatus ?? $passkey->backup_status,
        );
    }

    /**
     * On malformed input the library throws TypeError, RangeException, ValueError and
     * serializer exceptions besides its own, so all of them are a rejected ceremony.
     *
     * @template T
     *
     * @param callable(): T $step
     *
     * @return T
     *
     * @throws PasskeyLoginFailedException
     */
    private function guardLogin(callable $step): mixed
    {
        try {
            return $step();
        } catch (WebauthnException|SerializerException|InvalidArgumentException|RangeException|TypeError|ValueError) {
            throw new PasskeyLoginFailedException;
        } catch (Throwable $throwable) {
            $this->exceptionHandler->report($throwable);

            throw new PasskeyLoginFailedException;
        }
    }

    private function userHandle(int $userId): string
    {
        return hash_hmac(
            'sha256',
            'passkey-user:' . $userId,
            $this->requiredConfig('passkeys.user_handle_secret', 'PASSKEYS_USER_HANDLE_SECRET'),
            true,
        );
    }

    /**
     * @return list<PublicKeyCredentialDescriptor>
     */
    private function registeredCredentials(User $user): array
    {
        $descriptors = Passkey::query()
            ->whereBelongsTo($user)
            ->get()
            ->map(static fn (Passkey $passkey): PublicKeyCredentialDescriptor => PublicKeyCredentialDescriptor::create(
                type: PublicKeyCredentialDescriptor::CREDENTIAL_TYPE_PUBLIC_KEY,
                id: Base64UrlSafe::decodeNoPadding($passkey->credential_id),
                transports: array_values(array_filter($passkey->transports, is_string(...))),
            ))
            ->all();

        return array_values($descriptors);
    }

    private function ceremonySteps(): CeremonyStepManagerFactory
    {
        $factory = new CeremonyStepManagerFactory;
        /** @var list<string> $allowedOrigins */
        $allowedOrigins = Config::array('passkeys.allowed_origins');

        if ($allowedOrigins === []) {
            throw new RuntimeException('Set PASSKEYS_ALLOWED_ORIGINS: passkeys.allowed_origins is empty.');
        }

        $factory->setAllowedOrigins($allowedOrigins);

        return $factory;
    }

    /**
     * @return positive-int
     */
    private function timeoutMilliseconds(): int
    {
        return max(1, Config::integer('passkeys.challenge_ttl_seconds', 300)) * 1000;
    }

    private function relyingPartyId(): string
    {
        return $this->requiredConfig('passkeys.relying_party.id', 'PASSKEYS_RP_ID');
    }

    private function requiredConfig(string $key, string $envVariable): string
    {
        $value = Config::get($key);

        if (! is_string($value) || $value === '') {
            throw new RuntimeException("Set {$envVariable}: {$key} is missing.");
        }

        return $value;
    }
}
