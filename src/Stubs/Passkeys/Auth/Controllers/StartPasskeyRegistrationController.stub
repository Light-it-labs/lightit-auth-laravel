<?php

declare(strict_types=1);

namespace Lightit\Authentication\App\Controllers;

use Illuminate\Container\Attributes\CurrentUser;
use Illuminate\Http\JsonResponse;
use Lightit\Authentication\App\Requests\StartPasskeyRegistrationRequest;
use Lightit\Authentication\App\Resources\PasskeyRegistrationOptionsResource;
use Lightit\Authentication\Domain\Actions\StartPasskeyRegistrationAction;
use Lightit\Users\Domain\Models\User;

final readonly class StartPasskeyRegistrationController
{
    public function __invoke(
        #[CurrentUser]
        User $user,
        StartPasskeyRegistrationRequest $request,
        StartPasskeyRegistrationAction $startPasskeyRegistrationAction,
    ): JsonResponse {
        return PasskeyRegistrationOptionsResource::make($startPasskeyRegistrationAction->execute($user))->response();
    }
}
