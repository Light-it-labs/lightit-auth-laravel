<?php

declare(strict_types=1);

namespace Lightit\Authentication\App\Controllers;

use Illuminate\Http\JsonResponse;
use Lightit\Authentication\App\Requests\PasskeyLoginRequest;
use Lightit\Authentication\App\Resources\LoginResource;
use Lightit\Authentication\Domain\Actions\PasskeyLoginAction;

final readonly class PasskeyLoginController
{
    public function __invoke(PasskeyLoginRequest $request, PasskeyLoginAction $passkeyLoginAction): JsonResponse
    {
        $loginDto = $passkeyLoginAction->execute($request->toDto());

        return LoginResource::make($loginDto)->response();
    }
}
