<?php

declare(strict_types=1);

namespace Lightit\Authentication\App\Controllers;

use Illuminate\Container\Attributes\CurrentUser;
use Illuminate\Http\JsonResponse;
use Lightit\Authentication\App\Resources\PasskeyResource;
use Lightit\Authentication\Domain\Actions\ListPasskeysAction;
use Lightit\Users\Domain\Models\User;

final readonly class ListPasskeysController
{
    public function __invoke(
        #[CurrentUser]
        User $user,
        ListPasskeysAction $listPasskeysAction,
    ): JsonResponse {
        $passkeys = $listPasskeysAction->execute($user);

        return PasskeyResource::collection($passkeys)->response();
    }
}
