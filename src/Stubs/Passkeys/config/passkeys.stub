<?php

declare(strict_types=1);

$localDefaults = in_array(env('APP_ENV', 'production'), ['local', 'testing'], true);

return [

    /*
     * The relying party the browser binds every passkey to. `id` is the frontend's
     * host or a registrable parent domain of it (never a sibling host), without
     * scheme or port. Only `local` and `testing` fall back to localhost; anywhere else
     * passkeys refuse to run until PASSKEYS_RP_ID and PASSKEYS_ALLOWED_ORIGINS are set.
     */
    'relying_party' => [
        'id' => env('PASSKEYS_RP_ID', $localDefaults ? 'localhost' : null),
        'name' => env('PASSKEYS_RP_NAME', env('APP_NAME', 'Laravel')),
    ],

    /*
     * Full origins (scheme, host and port) allowed to run a ceremony, comma-separated.
     */
    'allowed_origins' => array_values(array_filter(array_map(
        trim(...),
        explode(',', (string) env('PASSKEYS_ALLOWED_ORIGINS', $localDefaults ? 'http://localhost:5173' : '')),
    ))),

    /*
     * Keys the user handle stored on every authenticator. Required, with no APP_KEY
     * fallback: never rotate it, since changing it invalidates every registered passkey.
     */
    'user_handle_secret' => env('PASSKEYS_USER_HANDLE_SECRET'),

    /*
     * How long a registration or sign-in challenge stays valid, in seconds.
     */
    'challenge_ttl_seconds' => (int) env('PASSKEYS_CHALLENGE_TTL_SECONDS', 300),

];
