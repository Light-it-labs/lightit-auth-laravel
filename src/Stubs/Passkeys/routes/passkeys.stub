<?php

declare(strict_types=1);

use Illuminate\Support\Facades\Route;
use Lightit\Authentication\App\Controllers\DeletePasskeyController;
use Lightit\Authentication\App\Controllers\ListPasskeysController;
use Lightit\Authentication\App\Controllers\RenamePasskeyController;
use Lightit\Authentication\App\Controllers\StartPasskeyRegistrationController;
use Lightit\Authentication\App\Controllers\StorePasskeyController;

Route::prefix('passkeys')
    ->middleware('auth:sanctum')
    ->group(static function (): void {
        Route::get('/', ListPasskeysController::class);
        Route::post('/', StorePasskeyController::class)->middleware('throttle:passkeys');
        Route::post('registration-options', StartPasskeyRegistrationController::class)->middleware('throttle:passkeys');

        Route::prefix('{passkey}')
            ->middleware('throttle:passkeys')
            ->group(static function (): void {
                Route::patch('/', RenamePasskeyController::class);
                Route::post('delete', DeletePasskeyController::class);
            })
            ->whereNumber('passkey');
    });
