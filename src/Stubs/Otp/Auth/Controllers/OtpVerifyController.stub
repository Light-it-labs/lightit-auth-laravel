<?php

declare(strict_types=1);

namespace Lightit\Authentication\App\Controllers;

use Illuminate\Http\JsonResponse;
use Lightit\Authentication\App\Requests\OtpVerifyRequest;
use Lightit\Authentication\Domain\Actions\ConsumeOtpAction;
use Lightit\Users\App\Resources\UserResource;

final readonly class OtpVerifyController
{
    public function __invoke(
        OtpVerifyRequest $request,
        ConsumeOtpAction $consumeOtpAction,
    ): JsonResponse {
        $dto = $request->toDto();

        $user = $consumeOtpAction->execute($dto);

        return UserResource::make($user)->response();
    }
}
