# --------------------------------------------------------------------------
# Cookie-based (Sanctum SPA) authentication
# --------------------------------------------------------------------------
# SameSite=lax works as long as the SPA and the API are same-site, meaning the
# same registrable domain - including different subdomains such as example.com
# and api.example.com. Only a genuinely cross-site pair needs
# SESSION_SAME_SITE=none, and that also requires SESSION_SECURE_COOKIE=true
# over HTTPS on both sides.
#
# Local development: SPA on http://localhost:5173, API on http://localhost
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost:5173
FRONTEND_URL=http://localhost:5173
CORS_SUPPORTS_CREDENTIALS=true
#
# Production: SPA on example.com, API on api.example.com. The leading dot on
# SESSION_DOMAIN shares the session cookie across both subdomains.
#   SESSION_DOMAIN=.example.com
#   SESSION_SECURE_COOKIE=true
#   SESSION_SAME_SITE=lax
#   SANCTUM_STATEFUL_DOMAINS=example.com
#   FRONTEND_URL=https://example.com
#   CORS_SUPPORTS_CREDENTIALS=true
