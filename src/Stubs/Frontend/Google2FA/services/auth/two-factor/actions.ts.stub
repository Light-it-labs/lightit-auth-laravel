import { useMutation, useQuery } from "@tanstack/react-query";

import { queryClient } from "@/config/query-client";
import { currentUserQuery } from "@/services/auth/actions";
import type { UseMutationProps } from "@/services/types";
import {
  completeTwoFactor,
  confirmTwoFactor,
  disableTwoFactor,
  enableTwoFactor,
  getTwoFactorStatus,
  regenerateRecoveryCodes,
  requestTwoFactorReset,
  resetTwoFactor,
  setupTwoFactor,
  verifyRecoveryCode,
} from "./api";

const TWO_FACTOR_SETUP_QUERY_KEY = "twoFactorSetup";

export const useTwoFactorSetup = (token: string) => {
  return useQuery({
    queryKey: [TWO_FACTOR_SETUP_QUERY_KEY, token],
    queryFn: () => {
      return setupTwoFactor({ token });
    },
    staleTime: Infinity,
    gcTime: 0,
    retry: false,
  });
};

export const removeTwoFactorSetupQueries = () => {
  queryClient.removeQueries({ queryKey: [TWO_FACTOR_SETUP_QUERY_KEY] });
};

export const useCompleteTwoFactor = (props?: UseMutationProps<typeof completeTwoFactor>) => {
  return useMutation({ mutationFn: completeTwoFactor, ...props });
};

export const useVerifyRecoveryCode = (props?: UseMutationProps<typeof verifyRecoveryCode>) => {
  return useMutation({ mutationFn: verifyRecoveryCode, ...props });
};

export const useRequestTwoFactorReset = (
  props?: UseMutationProps<typeof requestTwoFactorReset>,
) => {
  return useMutation({ mutationFn: requestTwoFactorReset, ...props });
};

export const useResetTwoFactor = (props?: UseMutationProps<typeof resetTwoFactor>) => {
  return useMutation({ mutationFn: resetTwoFactor, ...props });
};

export const useDisableTwoFactor = (props?: UseMutationProps<typeof disableTwoFactor>) => {
  return useMutation({ mutationFn: disableTwoFactor, ...props });
};

export const useRegenerateRecoveryCodes = (
  props?: UseMutationProps<typeof regenerateRecoveryCodes>,
) => {
  return useMutation({ mutationFn: regenerateRecoveryCodes, ...props });
};

export const twoFactorStatusQuery = {
  queryKey: ["{{ queryKeyScope }}", "twoFactorStatus"],
  queryFn: getTwoFactorStatus,
};

export const useTwoFactorStatus = () => {
  return useQuery(twoFactorStatusQuery);
};

export const refreshTwoFactorState = () => {
  return Promise.all([
    queryClient.invalidateQueries({ queryKey: twoFactorStatusQuery.queryKey }),
    queryClient.invalidateQueries({ queryKey: currentUserQuery.queryKey }),
  ]);
};

export const useEnableTwoFactor = (props?: UseMutationProps<typeof enableTwoFactor>) => {
  return useMutation({ mutationFn: enableTwoFactor, ...props });
};

export const useConfirmTwoFactor = (props?: UseMutationProps<typeof confirmTwoFactor>) => {
  return useMutation({ mutationFn: confirmTwoFactor, ...props });
};
