import { api } from "@/config/api";
import type {
  BearerTokenResult,
  MessageResult,
  OneTimePasswordPayload,
  PasswordPayload,
  RecoveryCodePayload,
  RegenerateRecoveryCodesResult,
  TwoFactorResetChallengeResult,
  TwoFactorSetupPayload,
  VerifyRecoveryCodeResult,
} from "./types";

// The 2FA exchange endpoints authenticate via a short-lived, encrypted challenge
// token that isn't a session yet - it identifies a user who hasn't fully logged
// in, so it travels as a manual Authorization header on each call below rather
// than relying on the shared client's cookie session. The shared client is used
// regardless, so cookies and CSRF are still handled the way the rest of the app
// expects.
const bearer = (token: string) => {
  return { headers: { Authorization: `Bearer ${token}` } };
};

export const setupTwoFactor = async ({ token }: { token: string }): Promise<TwoFactorSetupPayload> => {
  const response = await api.post("{{ twoFactorSetupEndpoint }}", undefined, bearer(token));

  return {{ currentUserResponseAccessor }};
};

export const completeTwoFactor = async ({
  token,
  oneTimePassword,
}: { token: string } & OneTimePasswordPayload): Promise<BearerTokenResult> => {
  const response = await api.post(
    "{{ twoFactorCompleteEndpoint }}",
    { one_time_password: oneTimePassword },
    bearer(token),
  );

  return {{ currentUserResponseAccessor }};
};

export const verifyRecoveryCode = async ({
  token,
  recoveryCode,
}: { token: string } & RecoveryCodePayload): Promise<VerifyRecoveryCodeResult> => {
  const response = await api.post(
    "{{ twoFactorVerifyRecoveryCodeEndpoint }}",
    { recovery_code: recoveryCode },
    bearer(token),
  );

  return {{ currentUserResponseAccessor }};
};

export const requestTwoFactorReset = async ({
  token,
  password,
}: { token: string } & PasswordPayload): Promise<TwoFactorResetChallengeResult> => {
  const response = await api.post(
    "{{ twoFactorRequestResetEndpoint }}",
    { password },
    bearer(token),
  );

  return {{ currentUserResponseAccessor }};
};

export const resetTwoFactor = async ({ token }: { token: string }): Promise<MessageResult> => {
  const response = await api.post("{{ twoFactorResetEndpoint }}", undefined, bearer(token));

  return {{ currentUserResponseAccessor }};
};

export const disableTwoFactor = async ({
  token,
  password,
}: { token: string } & PasswordPayload): Promise<MessageResult> => {
  const response = await api.post("{{ twoFactorDisableEndpoint }}", { password }, bearer(token));

  return {{ currentUserResponseAccessor }};
};

export const regenerateRecoveryCodes = async ({
  token,
  password,
}: { token: string } & PasswordPayload): Promise<RegenerateRecoveryCodesResult> => {
  const response = await api.post(
    "{{ twoFactorRegenerateRecoveryCodesEndpoint }}",
    { password },
    bearer(token),
  );

  return {{ currentUserResponseAccessor }};
};
