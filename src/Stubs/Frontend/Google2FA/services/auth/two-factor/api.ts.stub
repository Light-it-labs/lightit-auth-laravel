import { deepSnakeKeys } from "string-ts";

import { api, ensureCsrf } from "@/config/api";
import type { LoginPayload } from "@/services/auth/types";
import { {{ userSchemaFactory }} } from "{{ userSchemaImportPath }}";
import type { User } from "{{ userTypeImportPath }}";
import {
  isTwoFactorChallenge,
  type MessageResult,
  type OneTimePasswordPayload,
  type PasswordPayload,
  type RecoveryCodePayload,
  type RegenerateRecoveryCodesResult,
  type TwoFactorChallengeResult,
  type TwoFactorResetChallengeResult,
  type TwoFactorSetupPayload,
} from "./types";

const withChallengeToken = (token: string) => {
  return { headers: { Authorization: `Bearer ${token}` }, isAuthProbe: true };
};

export const loginWithTwoFactorChallenge = async (
  payload: LoginPayload,
): Promise<TwoFactorChallengeResult | null> => {
  await ensureCsrf();
  const response = await api.post("{{ loginEndpoint }}", deepSnakeKeys(payload));
  const body: unknown = {{ currentUserResponseAccessor }};

  return isTwoFactorChallenge(body) ? body : null;
};

export const setupTwoFactor = async ({
  token,
}: {
  token: string;
}): Promise<TwoFactorSetupPayload> => {
  const response = await api.post("{{ twoFactorSetupEndpoint }}", undefined, withChallengeToken(token));

  return {{ currentUserResponseAccessor }};
};

export const completeTwoFactor = async ({
  oneTimePassword,
  token,
}: { token: string } & OneTimePasswordPayload): Promise<User> => {
  const response = await api.post(
    "{{ twoFactorCompleteEndpoint }}",
    { one_time_password: oneTimePassword },
    withChallengeToken(token),
  );

  return {{ userSchemaFactory }}().parse(response.data.data);
};

export const verifyRecoveryCode = async ({
  recoveryCode,
  token,
}: { token: string } & RecoveryCodePayload): Promise<User> => {
  const response = await api.post(
    "{{ twoFactorVerifyRecoveryCodeEndpoint }}",
    { recovery_code: recoveryCode },
    withChallengeToken(token),
  );

  return {{ userSchemaFactory }}().parse(response.data.data);
};

export const requestTwoFactorReset = async ({
  password,
}: PasswordPayload): Promise<TwoFactorResetChallengeResult> => {
  const response = await api.post("{{ twoFactorRequestResetEndpoint }}", { password });

  return {{ currentUserResponseAccessor }};
};

export const resetTwoFactor = async ({ token }: { token: string }): Promise<MessageResult> => {
  const response = await api.post("{{ twoFactorResetEndpoint }}", undefined, withChallengeToken(token));

  return {{ currentUserResponseAccessor }};
};

export const disableTwoFactor = async ({ password }: PasswordPayload): Promise<MessageResult> => {
  const response = await api.post("{{ twoFactorDisableEndpoint }}", { password });

  return {{ currentUserResponseAccessor }};
};

export const regenerateRecoveryCodes = async ({
  password,
}: PasswordPayload): Promise<RegenerateRecoveryCodesResult> => {
  const response = await api.post("{{ twoFactorRegenerateRecoveryCodesEndpoint }}", { password });

  return {{ currentUserResponseAccessor }};
};
