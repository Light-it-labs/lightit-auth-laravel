import { Controller, type SubmitHandler, useForm } from "react-hook-form";
import { zodResolver } from "@hookform/resolvers/zod";

import { Button } from "@/components/ui/button";
import { ErrorMessage } from "@/components/ui/error-message";
import { InputOtp } from "@/components/ui/input-otp";
import { Label } from "@/components/ui/label";
import { useTranslation } from "@/i18n";
import { useCompleteTwoFactor } from "@/services/auth/two-factor/actions";
import { getOneTimePasswordSchema } from "@/services/auth/two-factor/schemas";
import type { OneTimePasswordPayload } from "@/services/auth/two-factor/types";
import { useTwoFactorCompletion } from "../-hooks/use-two-factor-completion";

const ONE_TIME_PASSWORD_LENGTH = 6;

const ONE_TIME_PASSWORD_SLOTS = Array.from({ length: ONE_TIME_PASSWORD_LENGTH }, (_, index) => {
  return index;
});

type OneTimePasswordFormProps = {
  token: string;
  autoFocus?: boolean;
};

export const OneTimePasswordForm = ({ autoFocus = false, token }: OneTimePasswordFormProps) => {
  const { t } = useTranslation();

  const completeTwoFactorMutation = useCompleteTwoFactor();
  const { onCompleted, onFailed } = useTwoFactorCompletion();

  const {
    control,
    formState: { errors },
    handleSubmit,
    resetField,
    setError,
  } = useForm({
    defaultValues: { oneTimePassword: "" },
    mode: "onSubmit",
    resolver: zodResolver(getOneTimePasswordSchema()),
  });

  const showCodeError = (message: string) => {
    resetField("oneTimePassword");
    setError("oneTimePassword", { type: "backend", message }, { shouldFocus: true });
  };

  const onSubmit: SubmitHandler<OneTimePasswordPayload> = (data) => {
    completeTwoFactorMutation.mutate(
      { token, ...data },
      {
        onSuccess: onCompleted,
        onError: (error) => {
          return onFailed(error, showCodeError);
        },
      },
    );
  };

  return (
    <form className="space-y-6" onSubmit={handleSubmit(onSubmit)}>
      <div className="flex flex-col gap-2">
        <Label htmlFor="oneTimePassword">{t("form.otp")}</Label>

        <Controller
          control={control}
          name="oneTimePassword"
          render={({ field }) => {
            return (
              <InputOtp.Root
                autoComplete="one-time-code"
                autoFocus={autoFocus}
                id="oneTimePassword"
                maxLength={ONE_TIME_PASSWORD_LENGTH}
                {...field}
              >
                <InputOtp.Group>
                  {ONE_TIME_PASSWORD_SLOTS.map((index) => {
                    return <InputOtp.Slot key={index} index={index} />;
                  })}
                </InputOtp.Group>
              </InputOtp.Root>
            );
          }}
        />

        <ErrorMessage errorMessage={errors.oneTimePassword?.message} />
      </div>

      <Button className="w-full" isLoading={completeTwoFactorMutation.isPending} type="submit">
        {t("twoFactor.verify.submit")}
      </Button>
    </form>
  );
};
