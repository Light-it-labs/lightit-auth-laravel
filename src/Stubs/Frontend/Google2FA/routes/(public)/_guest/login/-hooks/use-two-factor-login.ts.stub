import { useCallback } from "react";
import { useMutation } from "@tanstack/react-query";

import { loginWithTwoFactorChallenge } from "@/services/auth/two-factor/api";
import { useTwoFactorChallengeRouting } from "./use-two-factor-challenge-routing";

export const useTwoFactorLogin = () => {
  const routeChallenge = useTwoFactorChallengeRouting();

  const loginMutation = useMutation({ mutationFn: loginWithTwoFactorChallenge });
  const { mutate: loginMutate, mutateAsync: loginMutateAsync } = loginMutation;

  const withChallengeRouting = useCallback(
    (options: Parameters<typeof loginMutate>[1]): Parameters<typeof loginMutate>[1] => {
      return {
        ...options,
        onSuccess: async (challenge, ...rest) => {
          if (await routeChallenge(challenge)) {
            return;
          }

          await options?.onSuccess?.(challenge, ...rest);
        },
      };
    },
    [routeChallenge],
  );

  const mutate = useCallback<typeof loginMutate>(
    (payload, options) => {
      loginMutate(payload, withChallengeRouting(options));
    },
    [loginMutate, withChallengeRouting],
  );

  const mutateAsync = useCallback<typeof loginMutateAsync>(
    (payload, options) => {
      return loginMutateAsync(payload, withChallengeRouting(options));
    },
    [loginMutateAsync, withChallengeRouting],
  );

  return { ...loginMutation, mutate, mutateAsync };
};
