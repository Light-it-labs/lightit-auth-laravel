import { useTranslation } from "@/i18n";

const DATA_URL_PREFIX = "data:";

const toQrCodeImageSource = (qr: string) => {
  return qr.startsWith(DATA_URL_PREFIX)
    ? qr
    : `data:image/svg+xml;charset=utf-8,${encodeURIComponent(qr)}`;
};

type AuthenticatorSecretProps = {
  qr: string;
  secret: string;
};

export const AuthenticatorSecret = ({ qr, secret }: AuthenticatorSecretProps) => {
  const { t } = useTranslation();

  return (
    <section className="space-y-3">
      <p className="text-sm">{t("twoFactor.setup.scanQrCode")}</p>

      <img
        alt={t("twoFactor.setup.qrCodeAlt")}
        className="mx-auto size-48"
        src={toQrCodeImageSource(qr)}
      />

      <p className="text-sm">{t("twoFactor.setup.manualEntryKey")}</p>

      <code className="block rounded-md border p-2 text-center font-mono text-sm break-all">
        {secret}
      </code>
    </section>
  );
};
