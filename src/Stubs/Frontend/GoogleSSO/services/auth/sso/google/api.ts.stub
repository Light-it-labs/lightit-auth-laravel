import axios from "axios";
import { deepCamelKeys } from "string-ts";

import { env } from "@/config/env";
import type { GoogleLoginPayload, GoogleLoginResponse } from "./types";

const googleSsoApi = axios.create({
  baseURL: env.VITE_API_URL,
  headers: {
    "Content-Type": "application/json",
    Accept: "application/json",
  },
});

googleSsoApi.interceptors.response.use((response) => {
  response.data = deepCamelKeys(response.data);

  return response;
});

export const loginWithGoogle = async ({ idToken }: GoogleLoginPayload): Promise<GoogleLoginResponse> => {
  const response = await googleSsoApi.post("{{ googleSsoLoginEndpoint }}", { token: idToken });

  return {{ currentUserResponseAccessor }};
};
