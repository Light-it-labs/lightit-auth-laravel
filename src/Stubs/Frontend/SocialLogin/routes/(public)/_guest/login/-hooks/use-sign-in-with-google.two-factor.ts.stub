import { useMutation } from "@tanstack/react-query";
import { useNavigate, useSearch } from "@tanstack/react-router";

import { queryClient } from "@/config/query-client";
import { currentUserQuery } from "@/services/auth/actions";
import { signInWithSocialProvider } from "@/services/auth/social/api";
import {
  isSetupRequired,
  isTwoFactorChallenge,
  type TwoFactorChallengeResult,
} from "@/services/auth/two-factor/types";
import type { UseMutationProps } from "@/services/types";
import { useTwoFactorChallengeStore } from "@/stores/use-two-factor-challenge-store";

const signInWithGoogle = async (credential: string): Promise<TwoFactorChallengeResult | null> => {
  const body = await signInWithSocialProvider("google", credential);

  return isTwoFactorChallenge(body) ? body : null;
};

export const useSignInWithGoogle = (props?: UseMutationProps<typeof signInWithGoogle>) => {
  const navigate = useNavigate();
  const search = useSearch({ from: "/(public)/_guest" });
  const startChallenge = useTwoFactorChallengeStore.use.startChallenge();
  const clearChallenge = useTwoFactorChallengeStore.use.clearChallenge();

  return useMutation({
    mutationFn: signInWithGoogle,
    ...props,
    onSuccess: async (challenge, ...rest) => {
      if (challenge) {
        startChallenge(challenge);
        await navigate({
          to: isSetupRequired(challenge) ? "/two-factor/setup" : "/two-factor",
          search: { redirect: search.redirect },
        });

        return;
      }

      clearChallenge();
      await queryClient.refetchQueries({ queryKey: currentUserQuery.queryKey });
      await props?.onSuccess?.(challenge, ...rest);
    },
  });
};
