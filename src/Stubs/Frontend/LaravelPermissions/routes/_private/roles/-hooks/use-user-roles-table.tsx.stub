import { useMemo } from "react";
import { createColumnHelper } from "@tanstack/react-table";

import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { type TableFeatureSet, useTable, type UseTableProps } from "@/components/ui/table";
import { useTranslation } from "@/i18n";
import type { UserWithRoles } from "@/services/roles/types";

type UseUserRolesTableProps = Omit<UseTableProps<UserWithRoles>, "columns"> & {
  onEditRoles: (user: UserWithRoles) => void;
};

export const useUserRolesTable = ({ data = [], onEditRoles, ...props }: UseUserRolesTableProps) => {
  const { t } = useTranslation();

  const columns = useMemo(() => {
    const columnHelper = createColumnHelper<TableFeatureSet, UserWithRoles>();

    return columnHelper.columns([
      columnHelper.accessor("name", {
        meta: { stringifiedHeader: t("roles.table.name") },
        header: t("roles.table.name"),
      }),
      columnHelper.accessor("emailAddress", {
        meta: { stringifiedHeader: t("roles.table.email") },
        header: t("roles.table.email"),
      }),
      columnHelper.accessor("roles", {
        meta: { stringifiedHeader: t("roles.table.roles") },
        header: t("roles.table.roles"),
        cell: ({ getValue }) => {
          const roles = getValue();

          if (roles.length === 0) {
            return <span className="text-sm">{t("roles.table.noRoles")}</span>;
          }

          return (
            <div className="flex flex-wrap gap-1">
              {roles.map((role) => {
                return (
                  <Badge key={role} size="sm" variant="secondary">
                    {role}
                  </Badge>
                );
              })}
            </div>
          );
        },
      }),
      columnHelper.display({
        id: "actions",
        enableHiding: false,
        cell: ({ row }) => {
          return (
            <div className="flex justify-end">
              <Button
                size="sm"
                variant="outlined"
                onClick={() => {
                  onEditRoles(row.original);
                }}
              >
                {t("roles.edit.open")}
              </Button>
            </div>
          );
        },
      }),
    ]);
  }, [onEditRoles, t]);

  return useTable({ columns, data, ...props });
};
