import { HttpStatusCode, isAxiosError } from "axios";

import { api, ensureCsrf } from "@/config/api";
import { {{ userSchemaFactory }} } from "{{ userSchemaImportPath }}";
import type { User } from "{{ userTypeImportPath }}";
import type { LoginPayload } from "./types";

const CSRF_TOKEN_MISMATCH = 419;

export const login = async ({ email, password }: LoginPayload) => {
  await ensureCsrf();
  await api.post("{{ loginEndpoint }}", { email, password });
};

export const logout = async () => {
  await ensureCsrf();
  await api.post("{{ logoutEndpoint }}");
};

export const getCurrentUser = async (): Promise<User | null> => {
  try {
    const response = await api.get("{{ currentUserEndpoint }}");

    return {{ userSchemaFactory }}().parse({{ currentUserResponseAccessor }});
  } catch (error) {
    const status = isAxiosError(error) ? error.response?.status : undefined;
    if (status === HttpStatusCode.Unauthorized || status === CSRF_TOKEN_MISMATCH) {
      return null;
    }

    throw error;
  }
};
