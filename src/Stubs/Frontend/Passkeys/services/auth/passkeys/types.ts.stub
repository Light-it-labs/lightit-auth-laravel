import { WebAuthnError } from "@simplewebauthn/browser";

export type Passkey = {
  id: number;
  name: string;
  createdAt: string;
  lastUsedAt: string | null;
};

export type AddPasskeyPayload = {
  name: string;
  password: string;
};

export type RenamePasskeyPayload = Pick<Passkey, "id" | "name">;

export type DeletePasskeyPayload = Pick<Passkey, "id"> & {
  password: string;
};

export type PasskeyCeremonyFailure = "cancelled" | "unsupported";

const ceremonyFailureByErrorName: Partial<Record<string, PasskeyCeremonyFailure>> = {
  AbortError: "cancelled",
  NotAllowedError: "cancelled",
  NotSupportedError: "unsupported",
};

export const getPasskeyCeremonyFailure = (error: unknown): PasskeyCeremonyFailure | null => {
  if (error instanceof WebAuthnError && error.code === "ERROR_CEREMONY_ABORTED") {
    return "cancelled";
  }

  return error instanceof Error ? (ceremonyFailureByErrorName[error.name] ?? null) : null;
};
