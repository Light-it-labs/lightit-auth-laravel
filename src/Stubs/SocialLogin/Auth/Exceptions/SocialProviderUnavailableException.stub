<?php

declare(strict_types=1);

namespace Lightit\Authentication\Domain\Exceptions;

use Lightit\Shared\App\Exceptions\Http\HttpException;

final class SocialProviderUnavailableException extends HttpException
{
    #[\Override]
    protected int $status = 503;

    #[\Override]
    protected string $errorCode = 'social_provider_unavailable';

    /**
     * @var string
     */
    #[\Override]
    protected $message = 'The sign-in provider could not be reached. Try again later.';
}
