<?php

declare(strict_types=1);

namespace Lightit\Authentication\Domain\Actions;

use Illuminate\Support\Facades\Auth;
use Illuminate\Support\Facades\Config;
use Lightit\Authentication\Domain\DataTransferObjects\CredentialsDto;
use Lightit\Authentication\Domain\DataTransferObjects\LoginDto;
use Lightit\Authentication\Domain\Enums\TwoFactorReason;
use Lightit\Authentication\Domain\TwoFactorAuthenticatable;
use Lightit\Shared\App\Exceptions\Http\UnauthorizedException;
use Lightit\Users\Domain\Models\User;

final class LoginAction
{
    /**
     * @throws UnauthorizedException
     */
    public function execute(CredentialsDto $credentials): User|LoginDto
    {
        if (! Auth::attempt($credentials->toArray())) {
            throw new UnauthorizedException();
        }

        /** @var User $user */
        $user = Auth::user();

        if (Config::boolean('google2fa.enabled') && $user instanceof TwoFactorAuthenticatable) {
            $ttlMinutes = Config::integer('google2fa.challenge_ttl_minutes');

            if (! $user->hasTwoFactorAuthenticationConfigured() && Config::boolean('google2fa.mandatory')) {
                return new LoginDto(
                    accessToken: $user->create2faToken($ttlMinutes, TwoFactorReason::SetupRequired),
                    tokenType: TwoFactorReason::SetupRequired->value,
                    expiresIn: $ttlMinutes * 60,
                );
            }

            if ($user->hasTwoFactorAuthenticationSecretStored()) {
                return new LoginDto(
                    accessToken: $user->create2faToken($ttlMinutes, TwoFactorReason::VerificationRequired),
                    tokenType: TwoFactorReason::VerificationRequired->value,
                    expiresIn: $ttlMinutes * 60,
                );
            }
        }

        session()->regenerate();

        return $user;
    }
}
