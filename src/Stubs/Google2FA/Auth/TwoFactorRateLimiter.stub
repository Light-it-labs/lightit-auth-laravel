<?php

declare(strict_types=1);

namespace Lightit\Authentication\Domain;

use Illuminate\Cache\RateLimiting\Limit;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\RateLimiter;

/**
 * Registers the `2fa` limiter the `throttle:2fa` middleware needs.
 */
final class TwoFactorRateLimiter
{
    public static function register(): void
    {
        RateLimiter::for('2fa', function (Request $request): array {
            return [
                Limit::perMinute(5)->by(self::subjectKey($request)),
                Limit::perMinute(30)->by('2fa-ip|'.$request->ip()),
            ];
        });
    }

    /**
     * A signed-in user is keyed by id before anything else: on the `auth:sanctum`
     * routes the session authenticates the request and Sanctum ignores the
     * `Authorization` header, so keying by a header the caller chooses would hand
     * out a fresh bucket per invented token. Only the challenge endpoints, which
     * have no signed-in user, are keyed by their challenge token.
     */
    private static function subjectKey(Request $request): string
    {
        $userId = $request->user()?->getAuthIdentifier();

        if (is_scalar($userId)) {
            return '2fa-user|'.$userId;
        }

        $token = $request->bearerToken();

        return $token !== null ? '2fa-token|'.hash('sha256', $token) : '2fa-guest|'.$request->ip();
    }
}
