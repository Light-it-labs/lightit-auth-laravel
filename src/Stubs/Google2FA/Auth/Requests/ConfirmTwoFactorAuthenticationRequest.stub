<?php

declare(strict_types=1);

namespace Lightit\Authentication\App\Requests;

use Illuminate\Foundation\Http\FormRequest;

final class ConfirmTwoFactorAuthenticationRequest extends FormRequest
{
    public const string ONE_TIME_PASSWORD = 'one_time_password';

    public function rules(): array
    {
        return [
            self::ONE_TIME_PASSWORD => ['required', 'string', 'digits:6'],
        ];
    }

    public function getOneTimePassword(): string
    {
        return $this->string(self::ONE_TIME_PASSWORD)->toString();
    }
}
