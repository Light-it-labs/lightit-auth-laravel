<?php

declare(strict_types=1);

namespace Lightit\Authentication\Domain\Actions;

use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Hash;
use Lightit\Users\Domain\Models\User;

final readonly class ConsumeRecoveryCodeAction
{
    /**
     * Locks the user row for the whole check-then-consume sequence: reading
     * the codes, matching the supplied one and persisting the list without
     * it must all see (and act on) the same snapshot, or two concurrent
     * requests with the same recovery code could both pass the match and
     * each burn a different code.
     *
     * Returns the locked row with the code removed, or null when no code
     * matched and nothing was written.
     */
    public function execute(User $user, string $suppliedCode): User|null
    {
        return DB::transaction(static function () use ($user, $suppliedCode): User|null {
            /** @var User $lockedUser */
            $lockedUser = User::query()->whereKey($user->getKey())->lockForUpdate()->firstOrFail();

            $hashedCodes = $lockedUser->getRecoveryCodes();

            foreach ($hashedCodes as $index => $hash) {
                if (Hash::check($suppliedCode, $hash)) {
                    unset($hashedCodes[$index]);
                    $lockedUser->replaceRecoveryCodes(array_values($hashedCodes));

                    return $lockedUser;
                }
            }

            return null;
        });
    }
}
