<?php

declare(strict_types=1);

namespace Lightit\Authentication\Domain\Actions;

use Lightit\Authentication\Domain\Exceptions\TwoFactorAuthException;
use Lightit\Authentication\Domain\TwoFactorAttemptLimiter;
use Lightit\Shared\App\Exceptions\Http\UnauthenticatedException;
use Lightit\Users\Domain\Models\User;

final readonly class CompleteTwoFactorAuthenticationAction
{
    public function __construct(
        private VerifyOtpAction $verifyOtpAction,
        private LoginByUserAction $loginByUserAction,
    ) {}

    /**
     * @throws UnauthenticatedException
     * @throws TwoFactorAuthException
     */
    public function execute(User $user, string $oneTimePassword): User
    {
        TwoFactorAttemptLimiter::ensureNotLockedOut($user->id);

        $secret = $user->getTwoFactorAuthSecret();

        if (is_null($secret)) {
            throw new UnauthenticatedException(__('google2fa.secret_not_configured'));
        }

        $this->verifyOtpAction->execute($user->id, $secret, $oneTimePassword);

        TwoFactorAttemptLimiter::clear($user->id);

        if (! $user->hasTwoFactorAuthenticationEnabled()) {
            $user->activateTwoFactorAuthentication();
        }

        $this->loginByUserAction->executeAfterChallenge($user);

        return $user;
    }
}
