<?php

declare(strict_types=1);

namespace Lightit\Authentication\Domain\Actions;

use Illuminate\Contracts\Auth\Factory as AuthFactory;
use Illuminate\Contracts\Auth\StatefulGuard;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\Config;
use Lightit\Authentication\Domain\Enums\TwoFactorReason;
use Lightit\Authentication\Domain\Exceptions\TwoFactorChallengeException;
use Lightit\Users\Domain\Models\User;

/**
 * Gates a just-authenticated user for 2FA. `LoginByUserAction::execute()`
 * calls this for every login path this package generates; the boilerplate's
 * own native login is not generated by this package, so wiring one call to
 * this into it is the single manual step documented in AUTH-2FA-TODO.md.
 */
final class TwoFactorLoginGate
{
    public function __construct(
        private readonly AuthFactory $auth,
        private readonly Request $request,
    ) {
    }

    /**
     * @throws TwoFactorChallengeException
     */
    public function guardAgainstChallenge(User $user): void
    {
        if (! Config::boolean('google2fa.enabled')) {
            return;
        }

        /** @var int $ttlMinutes */
        $ttlMinutes = Config::integer('google2fa.challenge_ttl_minutes');

        if (! $user->hasTwoFactorAuthenticationConfigured() && Config::boolean('google2fa.mandatory')) {
            $this->tearDownSession();

            throw new TwoFactorChallengeException(
                token: $user->create2faToken($ttlMinutes, TwoFactorReason::SetupRequired),
                tokenType: TwoFactorReason::SetupRequired->value,
                expiresIn: $ttlMinutes * 60,
            );
        }

        if ($user->hasTwoFactorAuthenticationSecretStored()) {
            $this->tearDownSession();

            throw new TwoFactorChallengeException(
                token: $user->create2faToken($ttlMinutes, TwoFactorReason::VerificationRequired),
                tokenType: TwoFactorReason::VerificationRequired->value,
                expiresIn: $ttlMinutes * 60,
            );
        }
    }

    /**
     * The host login this package cannot generate (see the class docblock)
     * already called `$guard->attempt()` and `$request->session()->regenerate()`
     * before this gate ever runs, so an authenticated session exists the
     * instant a challenge is required. Tearing it down here - before the
     * exception carries the challenge response back to the client - is what
     * stops that response from doubling as a bypass of the challenge it asks
     * for.
     */
    private function tearDownSession(): void
    {
        /** @var StatefulGuard $guard */
        $guard = $this->auth->guard('web');

        $guard->logout();

        $this->request->session()->invalidate();
        $this->request->session()->regenerateToken();
    }
}
