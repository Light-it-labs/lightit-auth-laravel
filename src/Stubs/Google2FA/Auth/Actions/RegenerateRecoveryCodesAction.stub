<?php

declare(strict_types=1);

namespace Lightit\Authentication\Domain\Actions;

use Lightit\Authentication\Domain\Exceptions\TwoFactorAuthException;
use Lightit\Users\Domain\Models\User;

final readonly class RegenerateRecoveryCodesAction
{
    public function __construct(
        private PasswordValidatorAction $passwordValidatorAction,
        private GenerateRecoveryCodesAction $generateRecoveryCodesAction,
    ) {
    }

    /**
     * @throws TwoFactorAuthException
     *
     * @return array<string>
     */
    public function execute(User $user, string $password): array
    {
        if (! $user->hasTwoFactorAuthenticationConfigured()) {
            throw new TwoFactorAuthException(
                message: __('google2fa.cannot_regenerate_2fa_unconfigured'),
                reason: 'cannot_regenerate_2fa_unconfigured',
                status: 409,
            );
        }

        $this->passwordValidatorAction->execute($user, $password);

        return $this->generateRecoveryCodesAction->execute($user);
    }
}
