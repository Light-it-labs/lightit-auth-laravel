<?php

declare(strict_types=1);

namespace Lightit\Authentication\Domain\Actions;

use Lightit\Authentication\Domain\Exceptions\TwoFactorAuthException;
use Lightit\Authentication\Domain\TwoFactorAttemptLimiter;
use Lightit\Users\Domain\Models\User;

final readonly class VerifyRecoveryCodeAction
{
    public function __construct(
        private ConsumeRecoveryCodeAction $consumeRecoveryCodeAction,
        private LoginByUserAction $loginByUserAction,
    ) {}

    /**
     * @throws TwoFactorAuthException
     */
    public function execute(User $user, string $suppliedCode): User
    {
        TwoFactorAttemptLimiter::ensureNotLockedOut($user->id);

        $lockedUser = $this->consumeRecoveryCodeAction->execute($user, $suppliedCode);

        if (is_null($lockedUser)) {
            throw new TwoFactorAuthException(message: __('google2fa.invalid_recovery_code'), reason: 'invalid_recovery_code', status: 422);
        }

        TwoFactorAttemptLimiter::clear($user->id);

        $this->loginByUserAction->executeAfterChallenge($lockedUser);

        return $lockedUser;
    }
}
