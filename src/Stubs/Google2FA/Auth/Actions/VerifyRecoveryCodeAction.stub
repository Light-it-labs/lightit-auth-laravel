<?php

declare(strict_types=1);

namespace Lightit\Authentication\Domain\Actions;

use Illuminate\Support\Facades\Hash;
use Lightit\Shared\App\Exceptions\Http\UnauthenticatedException;
use Lightit\Users\Domain\Models\User;

final readonly class VerifyRecoveryCodeAction
{
    public function __construct(
        private LoginByUserAction $loginByUserAction,
    ) {
    }

    /**
     * @throws UnauthenticatedException
     */
    public function execute(User $user, string $suppliedCode): User
    {
        $hashedCodes = $user->getRecoveryCodes();

        if ($hashedCodes === []) {
            throw new UnauthenticatedException(__('google2fa.invalid_recovery_code'));
        }

        $matchIndex = -1;

        foreach ($hashedCodes as $index => $hash) {
            if (Hash::check($suppliedCode, $hash)) {
                $matchIndex = $index;

                break;
            }
        }

        if ($matchIndex === -1) {
            throw new UnauthenticatedException(__('google2fa.invalid_recovery_code'));
        }

        unset($hashedCodes[$matchIndex]);
        $user->replaceRecoveryCodes(array_values($hashedCodes));

        $this->loginByUserAction->executeAfterChallenge($user);

        return $user;
    }
}
