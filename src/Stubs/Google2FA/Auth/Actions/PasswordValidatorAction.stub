<?php

declare(strict_types=1);

namespace Lightit\Authentication\Domain\Actions;

use Illuminate\Support\Facades\Hash;
use Lightit\Authentication\Domain\Exceptions\TwoFactorAuthException;
use Lightit\Users\Domain\Models\User;

final readonly class PasswordValidatorAction
{
    /**
     * A wrong confirmation password is a 422, not a 401: the user is still
     * signed in, and the frontend sends every 401 back to the login screen.
     *
     * @throws TwoFactorAuthException
     */
    public function execute(User $user, string $password): void
    {
        if (! Hash::check($password, $user->getAuthPassword())) {
            throw new TwoFactorAuthException(
                message: __('google2fa.invalid_password'),
                reason: 'invalid_password',
                status: 422,
            );
        }
    }
}
