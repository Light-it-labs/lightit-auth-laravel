<?php

declare(strict_types=1);

namespace Lightit\Authentication\App\Controllers;

use Illuminate\Container\Attributes\CurrentUser;
use Illuminate\Http\JsonResponse;
use Lightit\Authentication\App\Requests\GenerateRecoveryCodesRequest;
use Lightit\Authentication\App\Resources\TwoFactorRecoveryCodesResource;
use Lightit\Authentication\Domain\Actions\RegenerateRecoveryCodesAction;
use Lightit\Users\Domain\Models\User;

final readonly class RegenerateRecoveryCodesController
{
    public function __invoke(
        #[CurrentUser]
        User $user,
        GenerateRecoveryCodesRequest $request,
        RegenerateRecoveryCodesAction $regenerateRecoveryCodesAction,
    ): JsonResponse {
        $recoveryCodes = $regenerateRecoveryCodesAction->execute($user, $request->getPassword());

        return TwoFactorRecoveryCodesResource::make($recoveryCodes)->response();
    }
}
