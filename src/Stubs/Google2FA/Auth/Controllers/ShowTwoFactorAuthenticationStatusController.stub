<?php

declare(strict_types=1);

namespace Lightit\Authentication\App\Controllers;

use Illuminate\Container\Attributes\CurrentUser;
use Illuminate\Http\JsonResponse;
use Lightit\Authentication\App\Resources\TwoFactorStatusResource;
use Lightit\Users\Domain\Models\User;

final readonly class ShowTwoFactorAuthenticationStatusController
{
    public function __invoke(
        #[CurrentUser]
        User $user,
    ): JsonResponse {
        return TwoFactorStatusResource::make($user)->response();
    }
}
