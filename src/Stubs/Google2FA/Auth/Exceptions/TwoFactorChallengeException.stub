<?php

declare(strict_types=1);

namespace Lightit\Authentication\Domain\Exceptions;

use Exception;
use Illuminate\Http\JsonResponse;
use Illuminate\Http\Request;

/**
 * Signals that an otherwise-successful login still needs to clear 2FA - see
 * TwoFactorLoginGate::guardAgainstChallenge(). This isn't an error: it
 * carries the same {access_token, token_type, expires_in} shape the
 * frontend's isSetupRequired / isVerificationRequired guards already expect
 * from a challenge response. It renders itself, rather than extending this
 * package's usual HttpException base, because that base's
 * {error_code, message} shape doesn't fit a continuation response.
 */
final class TwoFactorChallengeException extends Exception
{
    public function __construct(
        public readonly string $token,
        public readonly string $tokenType,
        public readonly int $expiresIn,
    ) {
        parent::__construct("Two-factor authentication required: {$tokenType}.");
    }

    public function render(Request $request): JsonResponse
    {
        return response()->json([
            'data' => [
                'access_token' => $this->token,
                'token_type' => $this->tokenType,
                'expires_in' => $this->expiresIn,
            ],
        ]);
    }
}
